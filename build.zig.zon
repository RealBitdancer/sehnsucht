.{
    .name = .sehnsucht,
    .brand = "SEHNSUCHT",
    .version = "0.1.1",
    .fingerprint = 0x6fc5c28bf1e09276, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .opal = .{
            .url = "git+https://github.com/RealBitdancer/opal-zig?ref=v2.0.1-1#729ca5819675ac4d0210ccd04a6187e8a0439786",
            .hash = "opal-2.0.1-1--ITPC2SaAACfR7EpZSOMCMZDrI5KIwPqpZ4Ocmtv_TOb",
        },
        .vaxis = .{
            .url = "git+https://github.com/rockorager/libvaxis#d63a23c593c9b82f0b2886840161fa1f1df983e9",
            .hash = "vaxis-0.6.0-BWNV_DsLCgCcKudOoFkyrSgjxUeLAOSf1LxwezEeVieH",
        },
        .zaudio = .{
            .url = "git+https://github.com/zig-gamedev/zaudio#b9997fc34640d9c80e25b7829b9ad53db8bcf7f2",
            .hash = "zaudio-0.11.0-dev-_M-91owyQQD3MVQa4F1xkPgwSFWQi4HhhNfDwKI0PBWX",
        },
        // Apple framework stubs for linking macOS targets. zaudio declares the
        // same package for its own artifact but propagates only linkFramework to
        // consumers, so the executable needs the search path in its own right.
        // Lazy: fetched only when the target is macOS, and never linked into the
        // binary, which resolves the frameworks by name at load time.
        .system_sdk = .{
            .url = "https://github.com/zig-gamedev/system_sdk/archive/c0dbf11cdc17da5904ea8a17eadc54dee26567ec.tar.gz",
            .hash = "system_sdk-0.3.0-dev-alwUNnYaaAJAtIdE2fg4NQfDqEKs7QCXy_qYukAOBfmF",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "doc",
        "playlists",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "THIRD_PARTY_LICENSES.md",
    },
}
